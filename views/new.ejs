<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write new chat</title>
</head>
<body>
    <h3>Write new chat....</h3>
    <form method="POST" action="/chats">
        <input name="from" placeholder="Who are you ?" type="text">
        <br><br>
        <textarea name="msg" >Write you message here!</textarea>
        <br><br>
        <input name="to" placeholder="add receiver" type="text">
        <br><br>
        <button>Create Chat</button>
    </form>
</body>
</html>